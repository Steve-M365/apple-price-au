---
/**
 * EducationOffers — Apple Education Store prices, kept strictly apart from
 * retail. An education price is only ever shown with its own eligibility note
 * and its own capture timestamp.
 */
import type { Offer, Product, Seller } from "../lib/data";
import { indexById } from "../lib/data";
import { productLabel, sellerLabel } from "../lib/present";
import Price from "./Price.astro";
import DataFreshness from "./DataFreshness.astro";
import EmptyState from "./EmptyState.astro";

export interface Props {
  offers: Offer[];
  products?: Product[];
  sellers?: Seller[];
  maxAgeHours?: number;
  limit?: number;
}

const { offers, products = [], sellers = [], maxAgeHours = 24, limit = 6 } = Astro.props;
const productsById = indexById(products);

const educationOffers = offers
  .filter((offer) => offer.kind.toLowerCase() === "education")
  .sort(
    (a, b) => (a.priceAud ?? Number.POSITIVE_INFINITY) - (b.priceAud ?? Number.POSITIVE_INFINITY),
  )
  .slice(0, limit);
---

{educationOffers.length === 0 ? (
  <EmptyState
    title="Education pricing not published yet"
    message="Education prices require verified eligibility, so they are captured and listed separately from retail. Nothing is shown here until an education price has been captured with a timestamp and its eligibility terms."
  />
) : (
  <div class="space-y-3">
    <p class="text-body text-ink-muted">
      Education prices are eligible-price observations, not general retail prices. They are never
      merged with retail figures or treated as available to everyone.
    </p>
    <ul class="divide-y divide-line border-y border-line">
      {educationOffers.map((offer) => (
        <li class="flex flex-wrap items-center justify-between gap-4 py-4">
          <div class="min-w-0">
            <p class="text-body font-semibold text-ink">
              {productLabel(productsById.get(offer.productId))}
            </p>
            <p class="text-caption text-ink-muted">{sellerLabel(offer.sellerId, sellers)}</p>
            {offer.url && (
              <a
                class="text-caption font-semibold text-accent underline decoration-line underline-offset-4 hover:text-accent-strong"
                href={offer.url}
                rel="noopener noreferrer"
              >
                View the captured offer
              </a>
            )}
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <Price amountAud={offer.priceAud} verification={offer.verification} size="body" />
            <DataFreshness capturedAt={offer.capturedAt} maxAgeHours={maxAgeHours} />
          </div>
        </li>
      ))}
    </ul>
  </div>
)}
