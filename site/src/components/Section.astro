---
/**
 * Section — a labelled landmark for a block of page content.
 * Section components inside it render their own empty state.
 */
export interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  class?: string;
}

const { id, title, eyebrow, intro, class: className } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class:list={["scroll-mt-6", className]}>
  <div class="max-w-3xl">
    {eyebrow && (
      <p class="mb-2 text-caption font-semibold uppercase tracking-widest text-accent-strong">
        {eyebrow}
      </p>
    )}
    <h2 id={headingId} class="text-heading-lg font-semibold tracking-tight text-ink">
      {title}
    </h2>
    {intro && <p class="mt-3 text-body-lg text-ink-muted">{intro}</p>}
  </div>
  <div class="mt-6">
    <slot />
  </div>
</section>
