---
/**
 * HeroDeals — the strongest published deals, three at a time.
 * Accepts the full arrays and renders an empty state when nothing qualifies.
 */
import type { Deal, Product, Seller } from "../lib/data";
import { indexById } from "../lib/data";
import { productLabel, sellerLabel, sortDealsBySaving } from "../lib/present";
import Price from "./Price.astro";
import DataFreshness from "./DataFreshness.astro";
import EmptyState from "./EmptyState.astro";

export interface Props {
  deals: Deal[];
  products?: Product[];
  sellers?: Seller[];
  maxAgeHours?: number;
}

const { deals, products = [], sellers = [], maxAgeHours = 24 } = Astro.props;
const productsById = indexById(products);
const featured = sortDealsBySaving(deals).slice(0, 3);
---

{featured.length === 0 ? (
  <EmptyState
    title="No deals captured yet"
    message="Once a price drop, promotion or gift-card bonus has been captured from a source with a timestamp, it appears here with what it saves, how it was verified and when it was last checked."
  />
) : (
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((deal) => (
      <li class="card flex flex-col gap-3 p-5" data-deal-id={deal.id}>
        <div>
          <p class="text-caption font-semibold uppercase tracking-widest text-accent-strong">
            {deal.kind.replace(/[_-]+/g, " ")}
          </p>
          <h3 class="mt-1 text-body-lg font-semibold text-ink">
            {deal.title ?? productLabel(productsById.get(deal.productId ?? ""))}
          </h3>
          <p class="mt-1 text-caption text-ink-muted">{sellerLabel(deal.sellerId, sellers)}</p>
        </div>
        <Price amountAud={deal.priceAud} verification={deal.verification} size="heading" />
        <DataFreshness capturedAt={deal.capturedAt} maxAgeHours={maxAgeHours} />
        {deal.url && (
          <a
            class="mt-auto text-body font-semibold text-accent underline decoration-line underline-offset-4 hover:text-accent-strong"
            href={deal.url}
            rel="noopener noreferrer"
          >
            View the captured offer
          </a>
        )}
      </li>
    ))}
  </ul>
)}
