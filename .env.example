# Orchard collector configuration.
# Copy to .env and fill in locally. Never commit .env.
# All values are read at runtime from the environment; nothing here is a default
# that would let the pipeline run without being explicitly configured.

# --- Alerting -------------------------------------------------------------
# Discord webhook for deal alerts. Absent = alerts are skipped with a warning.
DISCORD_WEBHOOK_URL=

# Optional phase 2 email alerts. Absent = disabled.
RESEND_API_KEY=
ALERT_EMAIL_TO=

# --- Collection behaviour ------------------------------------------------
# Polite defaults. Raise only with a documented reason.
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_CACHE_DIR=.cache/http
HTTP_USER_AGENT=OrchardPriceBot/1.0 (+https://github.com/Steve-M365/apple-price-au; contact: steve@example.com)
COLLECTOR_MAX_CONCURRENCY=2

# Set to 1 to write diagnostics for every fetch (defaults off in CI).
COLLECTOR_DEBUG_ARTEFACTS=0

# --- Amazon AU (optional official API path) ------------------------------
# Without these the Amazon adapter refuses to run and the curated feed is used.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# --- Site -----------------------------------------------------------------
# Public base URL, used for canonical links and the sitemap.
PUBLIC_SITE_URL=https://example.github.io/apple-price-au

# --- Gift card valuation ------------------------------------------------
# Value of one loyalty point in AUD. Documented in docs/GIFT-CARD-RULES.md.
LOYALTY_POINT_VALUE_AUD=0.005